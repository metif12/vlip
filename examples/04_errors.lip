;; examples/04_errors.lip
;; Two error mechanisms, deliberately. Half a design serves neither.
;;
;;   Result  -- for things a caller should reasonably handle. A value.
;;   raise   -- for invariant violations, i.e. bugs. Aborts.
;;
;; Gleam proved Result alone is unusable past three levels; Janet proved fibers
;; alone suffice for everything. vlip ships Result plus `use` now, and fibers
;; later, without changing the surface syntax.

;; --- constructing results ---
(ok 42)                        ;=> (ok 42)
(err 'not-found)               ;=> (err not-found)

;; --- the combinator set is fixed and small ---
(map-result (ok 2) (fn [x] (* x 10)))   ;=> (ok 20)
(map-result (err 'e) (fn [x] (* x 10))) ;=> (err e)

(unwrap-or (ok 1) 0)                   ;=> 1
(unwrap-or (err 'e) 0)                 ;=> 0

;; laziness is in the NAME, because in a Lisp every argument is evaluated
;; eagerly, so the eager variant of every combinator is a trap
(try-result (ok 2) (fn [x] (+ x 1)))   ;=> (ok 3)
(try-result (err 'e) (fn [x] (+ x 1))) ;=> (err e)

;; the lazy variants do not run the thunk unless it is needed
(lazy-unwrap (ok 1) (fn [] 0))          ;=> 1
(lazy-unwrap (err 'e) (fn [] 0))        ;=> 0    the thunk RAN
(lazy-map-result (err 'e) (fn [x] (/ x 0)))  ;=> (err e)  the fn never ran

(ok-value (ok 7))                      ;=> 7
(err-value (err 'e))                    ;=> e
(ok? (ok 1))                           ;=> #t
(err? (err 'e))                        ;=> #t

;; --- flattening: the workhorse ---
;; ok(ok(1)) becomes ok(1). Needed whenever a function returns a result of result.
(flatten-result (ok (ok 1)))           ;=> (ok 1)
(flatten-result (ok (err 'inner)))     ;=> (err inner)

;; --- all: many results into one ---
(all-results (ok 1) (ok 2))            ;=> (ok [1 2])
(all-results (ok 1) (err 'e))          ;=> (err e)

;; =====================================================================
;; use: the thing that makes Result usable
;; =====================================================================
;;
;; `use` calls a function with a callback, binding its results and running the
;; body at the SAME indentation level. No staircase, no early returns.

(use (parse-in "key: value")
  (print "parsed:" r1 "=" r2)          ;=> parsed: key = value
  (print "all good"))                  ;=> all good

;; if any step is an error, the body is skipped entirely and the error is the
;; value of the whole `use` expression
(use (parse-in "garbage")
  (print "never reached"))             ; nothing printed
;=> (err malformed)

;; --- and it stacks: four levels, four flat lines ---
(use (connect "localhost:8080")
  (use (authenticate conn :user "ada" :pass "s3cret")
    (use (open-transaction conn)
      (execute conn "INSERT ...")
      (commit conn)))
  (print "four levels, no nesting"))
;=> four levels, no nesting

;; Compare with a Lisp that lacks `use`, where the same code is four nested
;; callbacks or four nested lets with early returns threading error values.

;; =====================================================================
;; raise: for bugs, not for control flow
;; =====================================================================

(define (area shape)
  (match shape
    [(struct Circle r: r) (* 3.14 r r)]
    [(struct Rect w: w h: h) (* w h)]
    [_ (raise (error "area: unknown shape ~a" shape))]))   ; a bug, not a result

(area (Circle 1))                      ;=> 3.14
(area (Rect 2 3))                      ;=> 6

;; --- raise carries a message, and catch sees it ---
(try (raise (error "index ~a out of range" 99))
  #:catch [(err e) (print "caught:" (err-message e))]
  #:finally [(print "cleanup runs either way")])
;=> caught: index 99 out of range
;   cleanup runs either way

;; --- choosing between the two ---
;;   "will the caller handle this?"  -> Result
;;   "is this impossible?"          -> raise
;;
;; A Rule of Thumb: a Result means the function did its job and is reporting a
;; normal outcome. A raise means there is a bug in the caller or the code.

;; =====================================================================
;; assert: executable documentation
;; =====================================================================
;; Every function in a library should state what it promises, and the promise
;; should run. This is why the doc for a function is a test.

(define (mean xs)
  ;; mean of a non-empty list of numbers
  (assert (not= (length xs) 0) "mean of an empty list")
  (/ (fold + 0 xs) (length xs)))

(assert (= (mean [1 2 3]) 2)   "mean")
(assert (= (mean [10]) 10)     "mean of one")

;; assert failure aborts with a clear message, not a bare "false"
(assert (= 1 1) "one equals one")

(print "errors ok")